<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D336B"
    android:keepScreenOn="true">

    <!-- ЭКРАН 1: ГЛАВНЫЙ ЭКРАН С КАТЕГОРИЯМИ В 2 КОЛОНКИ -->
    <LinearLayout
        android:id="@+id/screenCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#182B5C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="LUMATV"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearchMain"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_icon_btn_bg"
                android:focusable="true"
                android:text="🔍"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRefreshMain"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_icon_btn_bg"
                android:focusable="true"
                android:text="↻"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnSettingsMain"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/tv_icon_btn_bg"
                android:focusable="true"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />
    </LinearLayout>

    <!-- ЭКРАН 2: КАНАЛЫ ВНУТРИ КАТЕГОРИИ В 2 КОЛОНКИ -->
    <LinearLayout
        android:id="@+id/screenCategoryChannels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#182B5C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnBackFromCategory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_icon_btn_bg"
                android:focusable="true"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCategoryHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Развлекательные"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearchCategory"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/tv_icon_btn_bg"
                android:focusable="true"
                android:text="🔍"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />
    </LinearLayout>

    <!-- ЭКРАН 3: ТРАНСКЛЯЦИЯ СЛЕВА + ДВЕ ВКЛАДКИ СПРАВА -->
    <FrameLayout
        android:id="@+id/screenPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/playerLeftArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    app:resize_mode="fit"
                    app:use_controller="false" />

                <TextView
                    android:id="@+id/tvClockOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="18dp"
                    android:shadowColor="#000000"
                    android:shadowRadius="4"
                    android:text="23:27"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/playerRightPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1D336B"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="#182B5C"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/tabLiveProgram"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/tv_tab_bg"
                        android:focusable="true"
                        android:nextFocusDown="@id/rvPlayerEpg"
                        android:nextFocusLeft="@id/playerView"
                        android:nextFocusRight="@id/tabArchiveProgram"
                        android:text="Прямой эфир"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/tabArchiveProgram"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/tv_tab_bg"
                        android:focusable="true"
                        android:nextFocusDown="@id/rvPlayerEpg"
                        android:nextFocusLeft="@id/tabLiveProgram"
                        android:text="Архив"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlayerEpg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nextFocusUp="@id/tabLiveProgram" />
            </LinearLayout>
        </LinearLayout>

        <!-- НИЖНЯЯ OSD ПАНЕЛЬ -->
        <LinearLayout
            android:id="@+id/osdBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC16254C"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOsdBadge"
                    android:layout_width="54dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:background="#2E4C9A"
                    android:gravity="center"
                    android:text="ТВ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOsdChannelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ТНТ"
                        android:textColor="#CBD8F8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOsdCurrentShow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Прямой эфир"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOsdNextShow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Далее: программа передач"
                        android:textColor="#A8BCE8"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOsdTimeRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="23:00
Далее 00:40"
                    android:textColor="#CBD8F8"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/osdProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:max="100"
                android:progress="40"
                android:progressBackgroundTint="#3B5599"
                android:progressTint="#C2D59B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOsdPlayPause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/tv_icon_btn_bg"
                    android:focusable="true"
                    android:text="❚❚"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnOsdTogglePanel"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/tv_icon_btn_bg"
                    android:focusable="true"
                    android:text="☰"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnOsdFavorite"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/tv_icon_btn_bg"
                    android:focusable="true"
                    android:text="♥"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnOsdAspect"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/tv_icon_btn_bg"
                    android:focusable="true"
                    android:text="⛶"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnOsdBackToList"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/tv_tile_bg"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="К списку каналов"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ЭКРАН 4: НАСТРОЙКИ -->
    <LinearLayout
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#243F85"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#182B5C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tv_icon_btn_bg"
                android:focusable="true"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSetPlaylists"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/tv_row_bg"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:text="Плейлисты"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSetEpg"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/tv_row_bg"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:text="Программа передач (EPG)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSetRefreshPlaylist"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/tv_row_bg"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:text="Обновить плейлист"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSetRefreshEpg"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/tv_row_bg"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:text="Обновить программу передач"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:padding="20dp"
            android:text="LumaTV, версия 4.0 (Встроен плейлист cdntv.online)"
            android:textColor="#A8BCE8"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
